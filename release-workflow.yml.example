# Copy this file to .github/workflows/release.yml at the repository root.
# Configure signing secrets first. This workflow publishes a release on main push.
name: Build and publish Android timer
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: write
concurrency:
  group: zeus-release
  cancel-in-progress: false
jobs:
  release:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: '17'
      - name: Prepare SDK
        shell: pwsh
        run: |
          $sdkManager = Join-Path $env:ANDROID_HOME 'cmdline-tools\latest\bin\sdkmanager.bat'
          & $sdkManager 'platforms;android-35' 'build-tools;35.0.0'
          if ($LASTEXITCODE -ne 0) { throw 'Android SDK installation failed' }
      - name: Build signed APK and update metadata
        shell: pwsh
        env:
          KEY_BASE64: ${{ secrets.ZEUS_KEYSTORE_BASE64 }}
          ZEUS_KEYSTORE_PASSWORD: ${{ secrets.ZEUS_KEYSTORE_PASSWORD }}
          REPOSITORY: ${{ github.repository }}
        run: |
          if ([string]::IsNullOrEmpty($env:KEY_BASE64) -or [string]::IsNullOrEmpty($env:ZEUS_KEYSTORE_PASSWORD)) { throw 'Configure signing secrets first' }
          if ($env:REPOSITORY -notmatch '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$') { throw 'Invalid repository' }
          $keyPath=Join-Path $env:RUNNER_TEMP 'zeus-release.keystore'
          [IO.File]::WriteAllBytes($keyPath,[Convert]::FromBase64String($env:KEY_BASE64))
          $number=[int]$env:GITHUB_RUN_NUMBER
          $version="0.2.$number"
          $code=100+$number
          $manifestPath='app\src\main\AndroidManifest.xml'
          $source=Get-Content -Raw -LiteralPath $manifestPath
          $source=$source -replace 'android:versionCode="\d+"',("android:versionCode=`"$code`"")
          $source=$source -replace 'android:versionName="[^"]+"',("android:versionName=`"$version`"")
          Set-Content -LiteralPath $manifestPath -Value $source -Encoding utf8NoBOM
          $configPath='app\src\main\java\kr\local\zeustimer\UpdateConfig.java'
          $config=Get-Content -Raw -LiteralPath $configPath
          $config=$config -replace 'REPOSITORY = "[^"]*"',("REPOSITORY = `"$env:REPOSITORY`"")
          Set-Content -LiteralPath $configPath -Value $config -Encoding utf8NoBOM
          New-Item -ItemType Directory -Force -Path dist | Out-Null
          .\build.ps1 -JdkPath $env:JAVA_HOME -BuildToolsPath (Join-Path $env:ANDROID_HOME 'build-tools\35.0.0') -AndroidJar (Join-Path $env:ANDROID_HOME 'platforms\android-35\android.jar') -WorkDir (Join-Path $env:RUNNER_TEMP 'zeus-build') -Keystore $keyPath -ApkPath "$PWD\dist\zeus-boss-timer.apk"
          .\tools\release-info.ps1 -Repository $env:REPOSITORY -ApkPath "$PWD\dist\zeus-boss-timer.apk"
          "RELEASE_TAG=v$version" | Out-File -FilePath $env:GITHUB_ENV -Append -Encoding utf8
      - name: Publish release
        shell: pwsh
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh release create $env:RELEASE_TAG 'dist\zeus-boss-timer.apk' 'dist\latest.json' --target $env:GITHUB_SHA --title $env:RELEASE_TAG --generate-notes --latest
          if ($LASTEXITCODE -ne 0) { throw 'Release publication failed' }
