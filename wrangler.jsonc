{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeus-boss-timer",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/data/catalog.json"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "zeus-boss-timer",
    "database_id": "bb7ddcf1-76ba-4af4-97a4-3f0583c5fecf",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{"binding": "PUSH_QUEUE", "queue": "zeus-boss-push"}],
    "consumers": [{
      "queue": "zeus-boss-push",
      "max_batch_size": 1,
      "max_batch_timeout": 0,
      "max_retries": 3,
      "retry_delay": 30
    }]
  },
  "ratelimits": [{
    "name": "API_RATE_LIMIT",
    "namespace_id": "1001",
    "simple": {"limit": 30, "period": 60}
  }, {
    "name": "ADMIN_LOGIN_LIMIT",
    "namespace_id": "1002",
    "simple": {"limit": 5, "period": 60}
  }],
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": true}
}
